<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.DiabloCowCounter" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/hunt_background</item>
        <item name="android:colorAccent">@color/hunt_gold</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Used by the starting window, before the activity or Compose can draw. -->
    <style name="Theme.DiabloCowCounter.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/hunt_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.DiabloCowCounter</item>
        <item name="android:colorAccent">@color/hunt_gold</item>
        <item name="android:statusBarColor">@color/hunt_background</item>
        <item name="android:navigationBarColor">@color/hunt_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
